<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<!-- BD pròpia del Catan -->
		<property name="hibernate.connection.url">jdbc:mysql://localhost:3306/catan?createDatabaseIfNotExist=true</property>
		<property name="hibernate.connection.username">root</property>
		<!-- Canvia-la per la teva contrasenya i no la pugis a repositoris públics -->
		<property name="hibernate.connection.password">super3</property>

		<!-- create: cada execució comença amb les taules buides i el Main les omple des dels CSV -->
		<property name="hibernate.hbm2ddl.auto">create</property>

		<!-- Imprescindible per al patró DAO (getCurrentSession) -->
		<property name="hibernate.current_session_context_class">thread</property>

		<property name="hibernate.show_sql">false</property>
		<property name="hibernate.format_sql">true</property>

		<!-- Entitats del Catan -->
		<mapping class="ProjecteHibernate.Partida"/>
		<mapping class="ProjecteHibernate.Hexagon"/>
		<mapping class="ProjecteHibernate.Vertex"/>
		<mapping class="ProjecteHibernate.Aresta"/>
		<mapping class="ProjecteHibernate.HexagonVertex"/>
		<mapping class="ProjecteHibernate.Jugador"/>
		<mapping class="ProjecteHibernate.RecursJugador"/>
		<mapping class="ProjecteHibernate.Construccio"/>
		<mapping class="ProjecteHibernate.Assentament"/>
		<mapping class="ProjecteHibernate.Poblat"/>
		<mapping class="ProjecteHibernate.Ciutat"/>
		<mapping class="ProjecteHibernate.Carretera"/>
		<mapping class="ProjecteHibernate.CartaDesenvolupament"/>
	</session-factory>
</hibernate-configuration>
