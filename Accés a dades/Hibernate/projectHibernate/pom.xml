<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ProjecteHibernate</groupId>
	<artifactId>hibernate</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<properties>
		<!-- "release" substitueix source + target i, a més, comprova que no fem servir APIs de versions posteriors -->
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Centralitzem les versions: si cal actualitzar, només es toca aquí -->
		<hibernate.version>6.6.58.Final</hibernate.version>
		<validator.version>8.0.5.Final</validator.version>
	</properties>

	<dependencies>
		<!-- Driver JDBC de MySQL. Des del 2026 segueix la numeració AA.M (26.7 = juliol 2026) -->
		<!-- https://mvnrepository.com/artifact/com.mysql/mysql-connector-j -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>26.7.0</version>
		</dependency>

		<!-- Hibernate ORM. Ja porta jakarta.persistence-api 3.1 com a dependència transitiva,
		     per això NO cal declarar-la a part -->
		<!-- https://mvnrepository.com/artifact/org.hibernate.orm/hibernate-core -->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
			<version>${hibernate.version}</version>
		</dependency>

		<!-- Bean Validation (@NotBlank, @Min, @Max...). Hibernate la detecta sola i valida abans d'INSERT/UPDATE -->
		<!-- https://mvnrepository.com/artifact/org.hibernate.validator/hibernate-validator -->
		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
			<version>${validator.version}</version>
		</dependency>

		<!-- Implementació d'Expression Language: la necessita Hibernate Validator per generar els missatges d'error -->
		<!-- https://mvnrepository.com/artifact/org.glassfish.expressly/expressly -->
		<dependency>
			<groupId>org.glassfish.expressly</groupId>
			<artifactId>expressly</artifactId>
			<version>5.0.0</version>
		</dependency>
		<dependency>
			<groupId>JDBC_MavenProject</groupId>
			<artifactId>JDBC_MavenProject</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
	</dependencies>
</project>